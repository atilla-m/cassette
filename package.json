{
  "name": "cassette",
  "version": "0.1.0-beta.1",
  "description": "A private, local-first desktop music library and player.",
  "private": true,
  "homepage": "https://github.com/atilla-m/cassette",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atilla-m/cassette.git"
  },
  "bugs": {
    "url": "https://github.com/atilla-m/cassette/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "release:linux": "node scripts/build-release.mjs --bundles appimage,deb,rpm",
    "release:windows": "node scripts/build-release.mjs --target x86_64-pc-windows-msvc --bundles nsis,msi",
    "tauri": "tauri"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
